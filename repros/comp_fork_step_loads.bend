# a fork of width 100 (2026-09-08, from the case K follow-up): every
# chain step's prologue loaded all of its params, and a step's params
# are the arguments of every later call plus the joiner's captures, so
# the steps' loads grew with the square of the width: 14950 loads and
# 20335 lines of C at width 100 (925 / 4398 at 25, 3725 / 7833 at 50).
# A step now loads only its own call's arguments and its result:
# 397 loads and 5779 lines at 100, growing linearly. Same output, 5850,
# in both modes and with both emitters; every benchmark binary is
# byte-identical, since clang already dropped the dead loads. The sum
# rides a let chain because a 100-deep nested add hits the bracket
# wall (class D). Compile time and C size only.

import Base

def nf(n: Nat, x: U32) -> U32:
  match n:
    case 0n:
      (x + 1 : U32)
    case 1n+p:
      (nf(p, x) + 1 : U32)

