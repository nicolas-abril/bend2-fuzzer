def V.set_dec?(+v: Bool, +r: V) -> V:
  V{id, name, ty, many, dec, of} = r
  V{id, name, ty, many, v, of}

def V.of?(+r: V) -> U32:
  V{id, name, ty, many, dec, of} = r
  of

def V.set_of?(+v: U32, +r: V) -> V:
  V{id, name, ty, many, dec, of} = r
  V{id, name, ty, many, dec, v}

# Reg : Base read once: its datatypes' ids by name, its defs, the defs by the head of their return type, the datatypes a type may instantiate
type Reg is Data:
  Reg{ids: Map<&2, U32>, defs: List<&2, Def>, byhead: Map<&2, List<&2, Def>>, pool: List<&2, U32>, words: List<&2, String>, frags: List<&2, String>, wordset: Map<&2, Unit>, basenames: List<&2, String>}

def Reg.ids?(+r: Reg) -> Map<&2, U32>:
  Reg{ids, defs, byhead, pool, words, frags, wordset, basenames} = r
  ids

def Reg.set_ids?(+v: Map<&2, U32>, +r: Reg) -> Reg:
  Reg{ids, defs, byhead, pool, words, frags, wordset, basenames} = r
  Reg{v, defs, byhead, pool, words, frags, wordset, basenames}

def Reg.defs?(+r: Reg) -> List<&2, Def>:
  Reg{ids, defs, byhead, pool, words, frags, wordset, basenames} = r
  defs

def Reg.set_defs?(+v: List<&2, Def>, +r: Reg) -> Reg:
  Reg{ids, defs, byhead, pool, words, frags, wordset, basenames} = r
  Reg{ids, v, byhead, pool, words, frags, wordset, basenames}

def Reg.byhead?(+r: Reg) -> Map<&2, List<&2, Def>>:
  Reg{ids, defs, byhead, pool, words, frags, wordset, basenames} = r
  byhead

def Reg.set_byhead?(+v: Map<&2, List<&2, Def>>, +r: Reg) -> Reg:
  Reg{ids, defs, byhead, pool, words, frags, wordset, basenames} = r
  Reg{ids, defs, v, pool, words, frags, wordset, basenames}

def Reg.pool?(+r: Reg) -> List<&2, U32>:
