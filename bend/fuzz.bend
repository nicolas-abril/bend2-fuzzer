  ps

def Wip.set_ps?(+v: List<&2, U32>, +r: Wip) -> Wip:
  Wip{name, col, ps, subs, calls} = r
  Wip{name, col, v, subs, calls}

def Wip.subs?(+r: Wip) -> List<&2, V>:
  Wip{name, col, ps, subs, calls} = r
  subs

def Wip.set_subs?(+v: List<&2, V>, +r: Wip) -> Wip:
  Wip{name, col, ps, subs, calls} = r
  Wip{name, col, ps, v, calls}

def Wip.calls?(+r: Wip) -> U32:
  Wip{name, col, ps, subs, calls} = r
  calls

def Wip.set_calls?(+v: U32, +r: Wip) -> Wip:
