# Wip : a def whose leaves are being drawn: a self-call passes a current sub-field at the decreasing column
type Wip is Data:
  Wip{name: String, col: U32, ps: List<&2, U32>, subs: List<&2, V>, calls: U32}

def Wip.name?(+r: Wip) -> String:
