  Wip{name, col, ps, subs, v}

# V : a binder in scope (the state's dead set holds the consumed ids). many: a + binder; dec: a sub-field the self-call may descend on; of: the parameter a variable row re-binds (0: none)
type V is Data:
  V{id: U32, name: String, ty: T, many: Bool, dec: Bool, of: U32}

def V.id?(+r: V) -> U32:
  V{id, name, ty, many, dec, of} = r
  id

def V.set_id?(+v: U32, +r: V) -> V:
  V{id, name, ty, many, dec, of} = r
  V{v, name, ty, many, dec, of}

def V.name?(+r: V) -> String:
  V{id, name, ty, many, dec, of} = r
  name

def V.set_name?(+v: String, +r: V) -> V:
  V{id, name, ty, many, dec, of} = r
  V{id, v, ty, many, dec, of}

def V.ty?(+r: V) -> T:
  V{id, name, ty, many, dec, of} = r
  ty

def V.set_ty?(+v: T, +r: V) -> V:
  V{id, name, ty, many, dec, of} = r
  V{id, name, v, many, dec, of}

def V.many?(+r: V) -> Bool:
  V{id, name, ty, many, dec, of} = r
  many

def V.set_many?(+v: Bool, +r: V) -> V:
  V{id, name, ty, many, dec, of} = r
  V{id, name, ty, v, dec, of}

def V.dec?(+r: V) -> Bool:
