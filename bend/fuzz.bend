  St{rng, uid, vid, steps, base, free, pure, trans, tmpl, surface, names, decls, entries, adts, own, fams, famids, defs, memo, wip, wips, mints, maxmints, feats, framed, dead, cost, reg, idn, leaves} = r
  St{rng, uid, vid, steps, base, free, pure, trans, tmpl, surface, names, decls, entries, adts, own, fams, famids, defs, memo, wip, wips, mints, maxmints, feats, framed, dead, cost, reg, idn, v}

def g.leaves?(st: St) -> St & Maybe<&1, U32>:
  St{rng, uid, vid, steps, base, free, pure, trans, tmpl, surface, names, decls, entries, adts, own, fams, famids, defs, memo, wip, wips, mints, maxmints, feats, framed, dead, cost, reg, idn, +leaves} = st
  (St{rng, uid, vid, steps, base, free, pure, trans, tmpl, surface, names, decls, entries, adts, own, fams, famids, defs, memo, wip, wips, mints, maxmints, feats, framed, dead, cost, reg, idn, leaves}, Some{leaves})

def s.leaves?(+v: U32, st: St) -> St & Maybe<&1, Unit>:
  (St.set_leaves(v, st), Some{Unit{}})

# END St

# The generator's monad
# =====================
# G(A) : a step of the generator: the state in, the state out beside the
# answer; None is a production's failure (no inhabitant here), which the
# rest of a do block skips, and G.or recovers from with the state it left.

def G(-A: Type) -> Type:
  St -> St & Maybe<&1, A>

def G.pure?(-A: Type, +x: A) -> G(A):
  s => (s, Some{x})

def G.fail?(-A: Type) -> G(A):
  s => (s, None{})

def G.bind.on?(-A: Type, -B: Type, +m: Maybe<&1, A>, f: A -> G(B), +s: St) -> St & Maybe<&1, B>:
  match m:
    case None{}:
      (s, None{})
    case Some{x}:
      f(x, s)

def G.bind.go?(-A: Type, -B: Type, f: A -> G(B), +r: St & Maybe<&1, A>) -> St & Maybe<&1, B>:
  (s, m) = r
  G.bind.on(A, B, m, f, s)

def G.bind?(-A: Type, -B: Type, m: G(A), f: A -> G(B)) -> G(B):
  s => G.bind.go(A, B, f, m(s))

# G.or : m, or when it fails, alt
def G.or.on?(-A: Type, +m: Maybe<&1, A>, alt: G(A), +s: St) -> St & Maybe<&1, A>:
  match m:
    case None{}:
      alt(s)
    case Some{x}:
      (s, Some{x})

def G.or.go?(-A: Type, alt: G(A), +r: St & Maybe<&1, A>) -> St & Maybe<&1, A>:
  (s, m) = r
  G.or.on(A, m, alt, s)

def G.or?(-A: Type, m: G(A), alt: G(A)) -> G(A):
  s => G.or.go(A, alt, m(s))

# G.try : m's answer as a Maybe (a failure is None, the state kept)
def G.try.go?(-A: Type, +r: St & Maybe<&1, A>) -> St & Maybe<&1, Maybe<&1, A>>:
  (s, m) = r
  (s, Some{m})

def G.try?(-A: Type, m: G(A)) -> G(Maybe<&1, A>):
  s => G.try.go(A, m(s))

# G.when : m when b, else x
def G.when?(-A: Type, +b: Bool, m: G(A), +x: A) -> G(A):
  match b:
    case True{}:
      m
    case False{}:
      G.pure(A, x)

# G.If : one of two steps, only the chosen one built (a step that recurses
# before its first bind would otherwise unfold at construction)
def G.If?(-A: Type, +b: Bool, t: Unit -> G(A), e: Unit -> G(A)) -> G(A):
  match b:
    case True{}:
      t(Unit{})
    case False{}:
      e(Unit{})

# G.if : one of two steps
def G.if?(-A: Type, +b: Bool, t: G(A), e: G(A)) -> G(A):
  match b:
    case True{}:
      t
    case False{}:
      e

# Rng
# ===
# splitmix32: the state steps by the golden ratio and the output mixes it

def mix32?(+z: U32) -> U32:
  +a = ((z .^. (z >> 16n)) * 2246822507 : U32)
  +b = ((a .^. (a >> 13n)) * 3266489909 : U32)
  (b .^. (b >> 16n) : U32)

def rand?() -> G(U32):
  do G<U32>:
    +r : U32 <-g.rng
    +s2 : U32 = (r + 2654435769 : U32)
    +u : Unit <-s.rng(s2)
    return mix32(s2)

# int : a draw in [0, n) (0 when n is 0)
def int?(+n: U32) -> G(U32):
  do G<U32>:
    +r : U32 <-rand()
    return (r % n : U32)

# chance : true with probability p per mille
def chance?(+p: U32) -> G(Bool):
  do G<Bool>:
    +r : U32 <-int(1000)
    return (r < p : U32)

# size : lo plus a Pareto draw of scale `scale` (tenths), capped: small by
# preference (the median is lo + ~0.5 scale), with a power-law tail of
# exponent TAIL (1.7)
def size?(+lo: U32, +scale10: U32, +cap: U32) -> G(U32):
  do G<U32>:
    +r : U32 <-int(1048576)
    +u : F32 = (U32.to_f32((r + 1 : U32)) / 1048576.0 : F32)
    +v : F32 = ((U32.to_f32(scale10) / 10.0 : F32) * (F32.pow(u, F32.neg(0.58823529)) - 1.0 : F32) : F32)
    return U32.min(cap, (lo + F32.to_u32(v) : U32))

# pick : an element of a list (d when it is empty)
def pick?(-A: Data, +d: A, +xs: List<&2, A>) -> G(A):
  do G<A>:
    +i : U32 <-int(L.len(A, xs))
    return L.nth(A, d, xs, i)

# wtotal / wpick : a weighted draw over (weight, value) pairs
def wtotal?(-A: Type, xs: List<&1, U32 & A>) -> U32:
  match xs:
    case []:
      0
    case (w, x) <> t:
      (w + wtotal(A, t) : U32)

# Quantities
# ==========

def Q0?() -> QT:
  QL{0}

def Q1?() -> QT:
  QL{1}

def Q2?() -> QT:
  QL{2}

def qt_str?(+q: QT) -> String:
  match q:
    case QL{n}:
      "&" ++ U32.show(n)
    case QV{n}:
      n
    case QM{a, b}:
      "(" ++ qt_str(a) ++ " <&> " ++ qt_str(b) ++ ")"

# qt_bare : a quantity term without the outer parens (inside Kind(..))
def qt_bare?(+q: QT) -> String:
  match q:
    case QM{a, b}:
      qt_str(a) ++ " <&> " ++ qt_str(b)
    case q:
      qt_str(q)

# qt_known : the quantity a term denotes, 3 when a variable is open
def qt_known?(+q: QT) -> U32:
  match q:
    case QL{n}:
      n
    case QV{n}:
      3
    case QM{a, b}:
      qt_known.meet(qt_known(a), qt_known(b))

def qt_known.meet?(+a: U32, +b: U32) -> U32:
  qt_known.meet.go(U32.is_eq(a, 3) || U32.is_eq(b, 3), a, b)

def qt_known.meet.go?(+open: Bool, +a: U32, +b: U32) -> U32:
  match open:
    case True{}:
      3
    case False{}:
      U32.min(a, b)

def qt_eq?(+a: QT, +b: QT) -> Bool:
  String.eq(qt_str(a), qt_str(b))

def qt_sub?(+q: QT, +m: Map<&2, QT>) -> QT:
  match q:
    case QL{n}:
      QL{n}
    case QV{n}:
      qt_sub.var(n, m)
    case QM{a, b}:
      QM{qt_sub(a, m), qt_sub(b, m)}

def qt_sub.var?(+n: String, +m: Map<&2, QT>) -> QT:
  qt_sub.var.go(S.has.m(QT, m, n), n, m)

def qt_sub.var.go?(+has: Bool, +n: String, +m: Map<&2, QT>) -> QT:
  match has:
    case True{}:
      M.get(QT, QV{n}, m, n)
    case False{}:
      QV{n}

# qt_fits : is a type of kind quantity have accepted where Kind(need) is
# demanded? Data fits every kind, every kind fits Kind(&0) and Kind(&1), a
# meet on the left needs both sides, a meet on the right either
def qt_fits?(+have: QT, +need: QT) -> Bool:
  qt_fits.go(U32.is_eq(qt_known(have), 2) || qt_lit_below2(need) || qt_eq(have, need), have, need)

def qt_lit_below2?(+q: QT) -> Bool:
  match q:
    case QL{n}:
      (n < 2 : U32)
    case q:
      False{}

def qt_fits.go?(+yes: Bool, +have: QT, +need: QT) -> Bool:
  match yes:
    case True{}:
      True{}
    case False{}:
      qt_fits.left(have, need)

def qt_fits.left?(+have: QT, +need: QT) -> Bool:
  match have:
    case QM{a, b}:
      (qt_fits(a, need) && qt_fits(b, need))
    case have:
      qt_fits.right(have, need)

def qt_fits.right?(+have: QT, +need: QT) -> Bool:
  match need:
    case QM{a, b}:
      (qt_fits(have, a) || qt_fits(have, b))
    case need:
      False{}

# Maps
# ====

def M.get?(-V: Data, +d: V, +m: Map<&2, V>, +k: String) -> V:
  Pair.snd(Map<&2, V>, V, Map.get(V, d, m, k))

def S.has.m?(-V: Data, +m: Map<&2, V>, +k: String) -> Bool:
  Pair.snd(Map<&2, V>, Bool, Map.has(&2, V, m, k))

def M.set?(-V: Data, +m: Map<&2, V>, +k: String, +v: V) -> Map<&2, V>:
  Map.set(&2, V, m, k, v)

def M.new?(-V: Data) -> Map<&2, V>:
  Map.new(&2, V)

# Types
# =====

def ADT0?() -> Adt:
  Adt{0, "?", [], [], [], QL{1}, None{}, False{}, True{}, False{}}

def FAM0?() -> Fam:
  Fam{0, "?", TVar{"?", QL{1}}, QL{1}, [], False{}}

def adt_of?(+tb: Map<&2, Adt>, +id: U32) -> Adt:
  M.get(Adt, ADT0(), tb, U32.show(id))

def fam_of?(+fb: Map<&2, Fam>, +id: U32) -> Fam:
  M.get(Fam, FAM0(), fb, U32.show(id))

def inst?(+a: U32) -> T:
  TAdt{a, [], [], [], 0}

# is_t : t is Base's datatype of that name
def is_t?(+tb: Map<&2, Adt>, +t: T, +name: String) -> Bool:
  match t:
    case TAdt{a, qs, args, iargs, spell}:
      is_t.go(adt_of(tb, a), name)
    case t:
      False{}

def is_t.go?(+a: Adt, +name: String) -> Bool:
  Adt{id, n, qps, tps, ips, kind, ctors, paren, base, rec} = a
  (base && String.eq(n, name))

# ty_infix : does the type render as an infix or arrow form (an arrow, an &
# or | chain, a bare dependent pair), which a juxtaposed position
# parenthesizes?
def ty_infix?(+t: T) -> Bool:
  match t:
    case TFun{q, dom, cod, ne}:
      Bool.not((ne && is_eql(dom)))
    case TAdt{a, qs, args, iargs, spell}:
      U32.is_eq(spell, 2)
    case TSig{x, a, b, q, spell}:
      (U32.is_eq(q, 1) && sig_infix(x, spell))
    case t:
      False{}

def is_eql?(+t: T) -> Bool:
  match t:
    case TEql{t, l, r}:
      True{}
    case t:
      False{}

def sig_infix?(+x: Maybe<&2, String>, +spell: U32) -> Bool:
  match x:
    case None{}:
      Bool.not((U32.is_eq(spell, 1) || U32.is_eq(spell, 2)))
    case Some{n}:
      U32.is_eq(spell, 0)

# ty_render : the SAFE rendering (never leads with '+'; the Plus sugar is
# ty_top's, at annotation sites). canon renders the structure alone (the
# spellings dropped, a program's datatype named with its id): the key of
# every memo
def ty_render?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T, +canon: Bool) -> String:
  match t:
    case TVar{n, q}:
      n
    case TApp{f, arg}:
      Fam.name(fam_of(fb, f)) ++ Bool.pick(String, canon, "#" ++ U32.show(f), "") ++ "(" ++ arg ++ ")"
    case TAdt{a, qs, args, iargs, spell}:
      ty_render.adt(tb, fb, adt_of(tb, a), qs, args, iargs, spell, canon)
    case TSig{x, a, b, q, spell}:
      ty_render.sig(tb, fb, x, a, b, q, spell, canon)
    case TFun{q, dom, cod, ne}:
      ty_render.fun(tb, fb, q, dom, cod, ne, canon)
    case TEql{t, l, r}:
      "{" ++ l ++ " == " ++ r ++ " : " ++ ty_render(tb, fb, t, canon) ++ "}"

# ty_render.grp : a part at a juxtaposed position (parenthesized when infix)
def ty_render.grp?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T, +canon: Bool) -> String:
  +s = ty_render(tb, fb, t, canon)
  Bool.pick(String, (Bool.not(canon) && ty_infix(t)), "(" ++ s ++ ")", s)

def ty_render.grps?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +ts: List<&2, T>, +canon: Bool) -> List<&2, String>:
  match ts:
    case []:
      []
    case h <> t:
      ty_render.grp(tb, fb, h, canon) <> ty_render.grps(tb, fb, t, canon)

def qts_str?(+qs: List<&2, QT>) -> List<&2, String>:
  match qs:
    case []:
      []
    case h <> t:
      qt_str(h) <> qts_str(t)

def all_q1?(+qs: List<&2, QT>) -> Bool:
  match qs:
    case []:
      True{}
    case h <> t:
      (U32.is_eq(qt_known(h), 1) && qt_lit(h) && all_q1(t))

def qt_lit?(+q: QT) -> Bool:
  match q:
    case QL{n}:
      True{}
    case q:
      False{}

def ty_render.adt?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +a: Adt, +qs: List<&2, QT>, +args: List<&2, T>, +iargs: List<&2, String>, +spell: U32, +canon: Bool) -> String:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = a
  +gs = ty_render.grps(tb, fb, args, canon)
  +fill = (Bool.not(canon) && Bool.not(List.is_empty(&2, T, args)) && all_q1(qs))
  +xs = L.cat(String, L.cat(String, Bool.pick(List<&2, String>, fill, [], qts_str(qs)), gs), iargs)
  +nm = name ++ Bool.pick(String, (canon && Bool.not(base)), "#" ++ U32.show(id), "")
  +plain = Bool.pick(String, paren, nm ++ "(" ++ S.join(xs, ", ") ++ ")", Bool.pick(String, List.is_empty(&2, String, xs), nm, nm ++ "<" ++ S.join(xs, ", ") ++ ">"))
  Bool.pick(String, (Bool.not(canon) && U32.is_eq(spell, 1)), "Or(" ++ S.join(gs, ", ") ++ ")",
    Bool.pick(String, (Bool.not(canon) && U32.is_eq(spell, 2)), S.join(gs, " | "), plain))

def ty_render.sig?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +x: Maybe<&2, String>, +a: T, +b: T, +q: U32, +spell: U32, +canon: Bool) -> String:
  +xn = Maybe.default(&2, String, x, "_")
  +dep = Bool.not(String.eq(xn, "_"))
  +ga = ty_render.grp(tb, fb, a, canon)
  +rb = ty_render(tb, fb, b, canon)
  +sigma = "Sigma<&" ++ U32.show(q) ++ ", &" ++ U32.show(q) ++ ", " ++ ga ++ ", " ++ xn ++ " => " ++ rb ++ ">"
  +gb = ty_render.grp(tb, fb, b, canon)
  +tup = Bool.pick(String, U32.is_eq(spell, 1), "Pair(" ++ ga ++ ", " ++ gb ++ ")", ga ++ " & " ++ gb)
  +dp = Bool.pick(String, U32.is_eq(spell, 3), "Exists(" ++ ga ++ ", " ++ xn ++ " => " ++ rb ++ ")", "&" ++ xn ++ ": " ++ ga ++ " -> " ++ rb)
  Bool.pick(String, (canon || U32.is_eq(spell, 2) || U32.is_eq(q, 2)), sigma, Bool.pick(String, dep, dp, tup))

def ty_render.fun?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +q: U32, +dom: T, +cod: T, +ne: Bool, +canon: Bool) -> String:
  If(String, (Bool.not(canon) && ne && is_eql(dom)), u => ty_render.ne(tb, fb, dom), u => ty_render.arrow(q, ty_render.grp(tb, fb, dom, canon), ty_render(tb, fb, cod, canon)))

def ty_render.arrow?(+q: U32, +d: String, +c: String) -> String:
  Bool.pick(String, U32.is_eq(q, 1), d ++ " -> " ++ c, "@" ++ bq_prefix(q) ++ "zq: " ++ d ++ " -> " ++ c)

def ty_render.ne?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T) -> String:
  match t:
    case TEql{t, l, r}:
      "{" ++ l ++ " != " ++ r ++ " : " ++ ty_render(tb, fb, t, False{}) ++ "}"
    case t:
      "?"

def bq_prefix?(+q: U32) -> String:
  Bool.pick(String, U32.is_eq(q, 0), "-", Bool.pick(String, U32.is_eq(q, 2), "+", ""))

def ty_str?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T) -> String:
  ty_render(tb, fb, t, False{})

def ty_key?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T) -> String:
  ty_render(tb, fb, t, True{})

def ty_grp?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T) -> String:
  ty_render.grp(tb, fb, t, False{})

# ty_top : the annotation-site rendering: the Plus sugar (an all-&2
# quantity block dropped behind a leading '+'), and a bare dependent pair
# parenthesized (it would head a binder)
def ty_top?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T) -> String:
  match t:
    case TAdt{a, qs, args, iargs, spell}:
      ty_top.adt(tb, fb, adt_of(tb, a), a, qs, args, iargs, spell)
    case TSig{x, a, b, q, spell}:
      ty_top.sig(tb, fb, x, a, b, q, spell)
    case t:
      ty_str(tb, fb, t)

def all_q2?(+qs: List<&2, QT>) -> Bool:
  match qs:
    case []:
      True{}
    case h <> t:
      (U32.is_eq(qt_known(h), 2) && qt_lit(h) && all_q2(t))

def ty_top.adt?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +ad: Adt, +a: U32, +qs: List<&2, QT>, +args: List<&2, T>, +iargs: List<&2, String>, +spell: U32) -> String:
  +rest = L.cat(String, ty_render.grps(tb, fb, args, False{}), iargs)
  +plus = (Bool.not(Adt.paren(ad)) && Bool.not(List.is_empty(&2, QT, qs)) && all_q2(qs))
  Bool.pick(String, plus, "+" ++ Adt.name(adt_of(tb, a)) ++ Bool.pick(String, List.is_empty(&2, String, rest), "", "<" ++ S.join(rest, ", ") ++ ">"),
    ty_str(tb, fb, TAdt{a, qs, args, iargs, spell}))

def ty_top.sig?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +x: Maybe<&2, String>, +a: T, +b: T, +q: U32, +spell: U32) -> String:
  +t = {TSig{x, a, b, q, spell} : T}
  If(String, U32.is_eq(q, 2), u => "+Sigma<" ++ ty_grp(tb, fb, a) ++ ", " ++ Maybe.default(&2, String, x, "_") ++ " => " ++ ty_str(tb, fb, b) ++ ">",
    u => ty_top.dep(Maybe.is_some(&2, String, x) && ty_infix(t), ty_str(tb, fb, t)))

def ty_top.dep?(+paren: Bool, +s: String) -> String:
  Bool.pick(String, paren, "(" ++ s ++ ")", s)

# ty_eq : structural equality (the spellings aside)
def ty_eq?(+a: T, +b: T) -> Bool:
  match a b:
    case TVar{n1, q1} TVar{n2, q2}:
      String.eq(n1, n2)
    case TAdt{a1, qs1, as1, is1, s1} TAdt{a2, qs2, as2, is2, s2}:
      (U32.is_eq(a1, a2) && qts_eq(qs1, qs2) && tys_eq(as1, as2) && strs_eq(is1, is2))
    case TApp{f1, g1} TApp{f2, g2}:
      (U32.is_eq(f1, f2) && String.eq(g1, g2))
    case TSig{x1, a1, b1, q1, s1} TSig{x2, a2, b2, q2, s2}:
      (maybe_str_eq(x1, x2) && ty_eq(a1, a2) && ty_eq(b1, b2) && U32.is_eq(q1, q2))
    case TFun{q1, d1, c1, n1} TFun{q2, d2, c2, n2}:
      (U32.is_eq(q1, q2) && ty_eq(d1, d2) && ty_eq(c1, c2))
    case TEql{t1, l1, r1} TEql{t2, l2, r2}:
      (ty_eq(t1, t2) && String.eq(l1, l2) && String.eq(r1, r2))
    case a b:
      False{}

def tys_eq?(+a: List<&2, T>, +b: List<&2, T>) -> Bool:
  match a b:
    case Nil{} Nil{}:
      True{}
    case Con{x, xs} Con{y, ys}:
      (ty_eq(x, y) && tys_eq(xs, ys))
    case a b:
      False{}

def qts_eq?(+a: List<&2, QT>, +b: List<&2, QT>) -> Bool:
  match a b:
    case Nil{} Nil{}:
      True{}
    case Con{x, xs} Con{y, ys}:
      (qt_eq(x, y) && qts_eq(xs, ys))
    case a b:
      False{}

def strs_eq?(+a: List<&2, String>, +b: List<&2, String>) -> Bool:
  match a b:
    case Nil{} Nil{}:
      True{}
    case Con{x, xs} Con{y, ys}:
      (String.eq(x, y) && strs_eq(xs, ys))
    case a b:
      False{}

def maybe_str_eq?(+a: Maybe<&2, String>, +b: Maybe<&2, String>) -> Bool:
  match a b:
    case None{} None{}:
      True{}
    case Some{x} Some{y}:
      String.eq(x, y)
    case a b:
      False{}

# zip_q / zip_t : a map from names to the values beside them
def zip_q?(+ns: List<&2, String>, +vs: List<&2, QT>, +m: Map<&2, QT>) -> Map<&2, QT>:
  match ns vs:
    case Con{n, ns2} Con{v, vs2}:
      zip_q(ns2, vs2, M.set(QT, m, n, v))
    case ns vs:
      m

def tvi_names?(+xs: List<&2, TVI>) -> List<&2, String>:
  match xs:
    case []:
      []
    case TVI{n, q} <> t:
      n <> tvi_names(t)

def iv_names?(+xs: List<&2, IVar>) -> List<&2, String>:
  match xs:
    case []:
      []
    case IV{n, t, s} <> r:
      n <> iv_names(r)

def zip_t?(+ns: List<&2, String>, +vs: List<&2, T>, +m: Map<&2, T>) -> Map<&2, T>:
  match ns vs:
    case Con{n, ns2} Con{v, vs2}:
      zip_t(ns2, vs2, M.set(T, m, n, v))
    case ns vs:
      m

# ty_quant : the type's kind quantity (may be open)
def ty_quant?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T) -> QT:
  match t:
    case TVar{n, q}:
      q
    case TAdt{a, qs, args, iargs, spell}:
      ty_quant.adt(adt_of(tb, a), qs)
    case TApp{f, arg}:
      Fam.kind(fam_of(fb, f))
    case TSig{x, a, b, q, spell}:
      Bool.pick(QT, U32.is_eq(q, 2), QL{2}, QL{1})
    case TFun{q, dom, cod, ne}:
      QL{1}
    case TEql{t, l, r}:
      QL{2}

def ty_quant.adt?(+a: Adt, +qs: List<&2, QT>) -> QT:
  qt_sub(Adt.kind(a), zip_q(Adt.qps(a), qs, M.new(QT)))

# ty_data : may this type sit under a + binder (concretely Data)?
def ty_data?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T) -> Bool:
  U32.is_eq(qt_known(ty_quant(tb, fb, t)), 2)

def qts_sub?(+qs: List<&2, QT>, +qm: Map<&2, QT>) -> List<&2, QT>:
  match qs:
    case []:
      []
    case h <> t:
      qt_sub(h, qm) <> qts_sub(t, qm)

def ty_sub?(+t: T, +m: Map<&2, T>, +qm: Map<&2, QT>) -> T:
  match t:
    case TVar{n, q}:
      Bool.pick(T, S.has.m(T, m, n), M.get(T, t, m, n), TVar{n, qt_sub(q, qm)})
    case TAdt{a, qs, args, iargs, spell}:
      TAdt{a, qts_sub(qs, qm), tys_sub(args, m, qm), iargs, spell}
    case TSig{x, a, b, q, spell}:
      TSig{x, ty_sub(a, m, qm), ty_sub(b, m, qm), q, spell}
    case TFun{q, dom, cod, ne}:
      TFun{q, ty_sub(dom, m, qm), ty_sub(cod, m, qm), ne}
    case TEql{t, l, r}:
      TEql{ty_sub(t, m, qm), l, r}
    case TApp{f, arg}:
      TApp{f, arg}

def tys_sub?(+ts: List<&2, T>, +m: Map<&2, T>, +qm: Map<&2, QT>) -> List<&2, T>:
  match ts:
    case []:
      []
    case h <> t:
      ty_sub(h, m, qm) <> tys_sub(t, m, qm)

# ty_tsub : the type with the term n replaced by e (an arm's sub-index at a
# literal, an index parameter at its argument, a witness)
def ty_tsub?(+t: T, +n: String, +e: String) -> T:
  match t:
    case TApp{f, arg}:
      TApp{f, str_sub(arg, n, e)}
    case TAdt{a, qs, args, iargs, spell}:
      TAdt{a, qs, tys_tsub(args, n, e), strs_sub(iargs, n, e), spell}
    case TSig{x, a, b, q, spell}:
      TSig{x, ty_tsub(a, n, e), Bool.pick(T, maybe_is(x, n), b, ty_tsub(b, n, e)), q, spell}
    case TFun{q, dom, cod, ne}:
      TFun{q, ty_tsub(dom, n, e), ty_tsub(cod, n, e), ne}
    case TEql{t, l, r}:
      TEql{t, str_sub(l, n, e), str_sub(r, n, e)}
    case TVar{v, q}:
      TVar{v, q}

def str_sub?(+s: String, +n: String, +e: String) -> String:
  Bool.pick(String, String.eq(s, n), e, s)

def strs_sub?(+xs: List<&2, String>, +n: String, +e: String) -> List<&2, String>:
  match xs:
    case []:
      []
    case h <> t:
      str_sub(h, n, e) <> strs_sub(t, n, e)

def tys_tsub?(+ts: List<&2, T>, +n: String, +e: String) -> List<&2, T>:
  match ts:
    case []:
      []
    case h <> t:
      ty_tsub(h, n, e) <> tys_tsub(t, n, e)

def maybe_is?(+x: Maybe<&2, String>, +n: String) -> Bool:
  match x:
    case None{}:
      False{}
    case Some{v}:
      String.eq(v, n)

# ty_mentions : does the type mention the term n? (a binder such a type
# holds cannot be shadowed while the value lives)
def ty_mentions?(+t: T, +n: String) -> Bool:
  match t:
    case TApp{f, arg}:
      String.eq(arg, n)
    case TAdt{a, qs, args, iargs, spell}:
      (S.in(n, iargs) || tys_mention(args, n))
    case TSig{x, a, b, q, spell}:
      (ty_mentions(a, n) || (Bool.not(maybe_is(x, n)) && ty_mentions(b, n)))
    case TFun{q, dom, cod, ne}:
      (ty_mentions(dom, n) || ty_mentions(cod, n))
    case TEql{t, l, r}:
      (String.eq(l, n) || String.eq(r, n))
    case TVar{v, q}:
      False{}

def tys_mention?(+ts: List<&2, T>, +n: String) -> Bool:
  match ts:
    case []:
      False{}
    case h <> t:
      (ty_mentions(h, n) || tys_mention(t, n))

# Index types : a term of Nat or of an enum (every constructor nullary)
# may index a family
def idx_type?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T) -> Bool:
  match t:
    case TAdt{a, qs, args, iargs, spell}:
      (List.is_empty(&2, QT, qs) && List.is_empty(&2, T, args) && List.is_empty(&2, String, iargs)
        && idx_type.adt(tb, adt_of(tb, a)) && ty_data(tb, fb, t))
    case t:
      False{}

# idx_type.adt : a closed datatype (an indexed one, whose constructors may
# all be nullary, is no index: its instance needs its index)
def idx_type.adt?(+tb: Map<&2, Adt>, +a: Adt) -> Bool:
  (List.is_empty(&2, String, Adt.qps(a)) && List.is_empty(&2, TVI, Adt.tps(a)) && List.is_empty(&2, IVar, Adt.ips(a))
    && idx_type.cs(Adt.ctors(a), (Adt.base(a) && String.eq(Adt.name(a), "Nat"))))

def idx_type.cs?(+ctors: Maybe<&2, List<&2, Ctor>>, +nat: Bool) -> Bool:
  match ctors:
    case None{}:
      False{}
    case Some{cs}:
      (Bool.not(List.is_empty(&2, Ctor, cs)) && (nat || all_nullary(cs)))

def all_nullary?(+cs: List<&2, Ctor>) -> Bool:
  match cs:
    case []:
      True{}
    case Ct{n, fs} <> t:
      (List.is_empty(&2, Field, fs) && all_nullary(t))

def ctor_lits?(+cs: List<&2, Ctor>) -> List<&2, String>:
  match cs:
    case []:
      []
    case Ct{n, fs} <> t:
      (n ++ "{}") <> ctor_lits(t)

# idx_lits : the closed literals drawn for an index type (Nat: 0..3)
def idx_lits?(+tb: Map<&2, Adt>, +t: T) -> List<&2, String>:
  match t:
    case TAdt{a, qs, args, iargs, spell}:
      Bool.pick(List<&2, String>, is_t(tb, t, "Nat"), ["0n", "1n", "2n", "3n"], ctor_lits(Maybe.default(&2, List<&2, Ctor>, Adt.ctors(adt_of(tb, a)), [])))
    case t:
      []

def idx_first?(+tb: Map<&2, Adt>, +t: T) -> String:
  L.nth(String, "?", idx_lits(tb, t), 0)

# idx_is_lit : is the index term a closed literal of its type?
def idx_is_lit?(+tb: Map<&2, Adt>, +t: T, +arg: String) -> Bool:
  Bool.pick(Bool, is_t(tb, t, "Nat"), nat_lit(arg), String.ends_with(arg, "{}"))

def nat_lit?(+s: String) -> Bool:
  (String.ends_with(s, "n") && Bool.not(String.is_empty(String.drop(s, 1n))) && all_digits(String.take(s, Nat.sub(String.length(s), 1n))))

def all_digits?(+s: String) -> Bool:
  match s:
    case SNil{}:
      True{}
    case SCon{c, t}:
      (Char.is_digit(c) && all_digits(t))

# ty_open : does the type mention a type or quantity variable, or an index
# term?
def ty_open?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T) -> Bool:
  match t:
    case TVar{n, q}:
      True{}
    case TApp{f, arg}:
      Bool.not(idx_is_lit(tb, Fam.idx(fam_of(fb, f)), arg))
    case TSig{x, a, b, q, spell}:
      (ty_open(tb, fb, a) || ty_open(tb, fb, ty_open.ev(tb, fb, x, a, b)))
    case TAdt{a, qs, args, iargs, spell}:
      (tys_open(tb, fb, args) || qts_open(qs) || iargs_open(tb, Adt.ips(adt_of(tb, a)), iargs))
    case TFun{q, dom, cod, ne}:
      (ty_open(tb, fb, dom) || ty_open(tb, fb, cod))
    case TEql{t, l, r}:
      ty_open(tb, fb, t)

# ty_open.ev : a pair's evidence, closed once its witness is a literal
def ty_open.ev?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +x: Maybe<&2, String>, +a: T, +b: T) -> T:
  match x:
    case None{}:
      b
    case Some{n}:
      Bool.pick(T, idx_type(tb, fb, a), ty_tsub(b, n, idx_first(tb, a)), b)

def tys_open?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +ts: List<&2, T>) -> Bool:
  match ts:
    case []:
      False{}
    case h <> t:
      (ty_open(tb, fb, h) || tys_open(tb, fb, t))

def qts_open?(+qs: List<&2, QT>) -> Bool:
  match qs:
    case []:
      False{}
    case h <> t:
      (U32.is_eq(qt_known(h), 3) || qts_open(t))

def iargs_open?(+tb: Map<&2, Adt>, +ips: List<&2, IVar>, +xs: List<&2, String>) -> Bool:
  match ips xs:
    case Con{IV{n, t, s}, ips2} Con{x, xs2}:
      (Bool.not(idx_is_lit(tb, t, x)) || iargs_open(tb, ips2, xs2))
    case ips xs:
      False{}

# ctor_fields : a constructor's fields at an instance: type and quantity
# arguments substituted, index parameters replaced by the instance's
def ctor_fields?(+tb: Map<&2, Adt>, +t: T, +ct: Ctor) -> List<&2, Field>:
  match t:
    case TAdt{a, qs, args, iargs, spell}:
      ctor_fields.go(adt_of(tb, a), qs, args, iargs, Ctor.fields.of(ct))
    case t:
      []

def Ctor.fields.of?(+ct: Ctor) -> List<&2, Field>:
  Ct{n, fs} = ct
  fs

def Ctor.name.of?(+ct: Ctor) -> String:
  Ct{n, fs} = ct
  n

def ctor_fields.go?(+a: Adt, +qs: List<&2, QT>, +args: List<&2, T>, +iargs: List<&2, String>, +fs: List<&2, Field>) -> List<&2, Field>:
  match fs:
    case []:
      []
    case Fd{q, ft} <> rest:
      Fd{q, tsub_ips(Adt.ips(a), iargs, ty_sub(ft, zip_t(tvi_names(Adt.tps(a)), args, M.new(T)), zip_q(Adt.qps(a), qs, M.new(QT))))}
        <> ctor_fields.go(a, qs, args, iargs, rest)

def tsub_ips?(+ips: List<&2, IVar>, +xs: List<&2, String>, +t: T) -> T:
  match ips xs:
    case Con{IV{n, it, s}, ips2} Con{x, xs2}:
      tsub_ips(ips2, xs2, ty_tsub(t, n, x))
    case ips xs:
      t

# fam_unfold : the arm a closed index selects, its sub-index substituted;
# None on a variable index
def fam_unfold?(+tb: Map<&2, Adt>, +f: Fam, +arg: String) -> Maybe<&2, T>:
  Fam{id, name, idx, kind, arms, done} = f
  fam_unfold.go(idx_is_lit(tb, idx, arg), is_t(tb, idx, "Nat"), arms, arg)

def fam_unfold.go?(+lit: Bool, +nat: Bool, +arms: List<&2, Arm>, +arg: String) -> Maybe<&2, T>:
  match lit:
    case False{}:
      None{}
    case True{}:
      Bool.pick(Maybe<&2, T>, nat, fam_unfold.nat(arms, U32.from_nat(Maybe.default(&2, Nat, Nat.read(String.take(arg, Nat.sub(String.length(arg), 1n))), 0n))), fam_unfold.lit(arms, arg))

def fam_unfold.nat?(+arms: List<&2, Arm>, +n: U32) -> Maybe<&2, T>:
  fam_unfold.nat.arm(L.nth(Arm, ARM0(), arms, Bool.pick(U32, U32.is_zero(n), 0, 1)), n)

def fam_unfold.nat.arm?(+arm: Arm, +n: U32) -> Maybe<&2, T>:
  Arm{pat, sub, lit, ty, src} = arm
  match sub:
    case None{}:
      Some{ty}
    case Some{s}:
      Some{ty_tsub(ty, s, U32.show((n - 1 : U32)) ++ "n")}

def fam_unfold.lit?(+arms: List<&2, Arm>, +arg: String) -> Maybe<&2, T>:
  match arms:
    case []:
      None{}
    case Arm{pat, sub, lit, ty, src} <> t:
      If(Maybe<&2, T>, maybe_is(lit, arg), u => Some{ty}, u => fam_unfold.lit(t, arg))

def ARM0?() -> Arm:
  Arm{"?", None{}, None{}, TVar{"?", QL{1}}, "?"}

# head : the registry's index of a type (a type variable matches any head)
def head?(+tb: Map<&2, Adt>, +t: T) -> String:
  match t:
    case TAdt{a, qs, args, iargs, spell}:
      head.adt(adt_of(tb, a))
    case TApp{f, arg}:
      "f:" ++ U32.show(f)
    case TVar{n, q}:
      "*"
    case TSig{x, a, b, q, spell}:
      "sig"
    case TFun{q, dom, cod, ne}:
      "fun"
    case TEql{t, l, r}:
      "eql"

def head.adt?(+a: Adt) -> String:
  "a:" ++ Adt.name(a) ++ Bool.pick(String, Adt.base(a), "", "'")

# Unification
# ===========
# ty_unify : binds pat's type and quantity variables so pat matches goal,
# answering the extended maps, or None

type Un is Data:
  Un{m: Map<&2, T>, qm: Map<&2, QT>}

def Un0?() -> Un:
  Un{M.new(T), M.new(QT)}

def Un.m?(+u: Un) -> Map<&2, T>:
  Un{m, qm} = u
  m

def Un.qm?(+u: Un) -> Map<&2, QT>:
  Un{m, qm} = u
  qm

def ty_unify?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +pat: T, +goal: T, +u: Un) -> Maybe<&2, Un>:
  match pat:
    case TVar{n, q}:
      unify.var(tb, fb, n, q, goal, u, S.has.m(T, Un.m(u), n))
    case TAdt{a, qs, args, iargs, spell}:
      unify.adt(tb, fb, a, qs, args, iargs, goal, u)
    case TSig{x, a, b, q, spell}:
      unify.sig(tb, fb, x, a, b, q, goal, u)
    case TFun{q, dom, cod, ne}:
      unify.fun(tb, fb, q, dom, cod, goal, u)
    case pat:
      Bool.pick(Maybe<&2, Un>, ty_eq(pat, goal), Some{u}, None{})

# unify.var : a bound variable must meet the same type again; a free one
# binds to a type that fits its declared kind
def unify.var?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +n: String, +q: QT, +goal: T, +u: Un, +bound: Bool) -> Maybe<&2, Un>:
  match bound:
    case True{}:
      Bool.pick(Maybe<&2, Un>, ty_eq(M.get(T, goal, Un.m(u), n), goal), Some{u}, None{})
    case False{}:
      Bool.pick(Maybe<&2, Un>, qt_fits(ty_quant(tb, fb, goal), qt_sub(q, Un.qm(u))), Some{Un{M.set(T, Un.m(u), n, goal), Un.qm(u)}}, None{})

def unify.adt?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +a: U32, +qs: List<&2, QT>, +args: List<&2, T>, +iargs: List<&2, String>, +goal: T, +u: Un) -> Maybe<&2, Un>:
  match goal:
    case TAdt{a2, qs2, args2, iargs2, spell2}:
      If(Maybe<&2, Un>, (U32.is_eq(a, a2) && strs_eq(iargs, iargs2)), v => tys_unify(tb, fb, args, args2, qts_unify(qs, qs2, Some{u})), v => None{})
    case goal:
      None{}

def unify.sig?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +x: Maybe<&2, String>, +a: T, +b: T, +q: U32, +goal: T, +u: Un) -> Maybe<&2, Un>:
  match goal:
    case TSig{x2, a2, b2, q2, s2}:
      If(Maybe<&2, Un>, (U32.is_eq(q, q2) && Bool.not(Bool.xor(Maybe.is_some(&2, String, x), Maybe.is_some(&2, String, x2)))),
        v => tys_unify(tb, fb, [a, sig_rename(x, x2, b)], [a2, b2], Some{u}), v => None{})
    case goal:
      None{}

def sig_rename?(+x: Maybe<&2, String>, +x2: Maybe<&2, String>, +b: T) -> T:
  match x x2:
    case Some{n} Some{n2}:
      ty_tsub(b, n, n2)
    case x x2:
      b

def unify.fun?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +q: U32, +dom: T, +cod: T, +goal: T, +u: Un) -> Maybe<&2, Un>:
  match goal:
    case TFun{q2, d2, c2, n2}:
      If(Maybe<&2, Un>, U32.is_eq(q, q2), v => tys_unify(tb, fb, [dom, cod], [d2, c2], Some{u}), v => None{})
    case goal:
      None{}

def tys_unify?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +ps: List<&2, T>, +gs: List<&2, T>, +r: Maybe<&2, Un>) -> Maybe<&2, Un>:
  match r:
    case None{}:
      None{}
    case Some{u}:
      tys_unify.go(tb, fb, ps, gs, u)

def tys_unify.go?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +ps: List<&2, T>, +gs: List<&2, T>, +u: Un) -> Maybe<&2, Un>:
  match ps gs:
    case Con{p, ps2} Con{g, gs2}:
      tys_unify(tb, fb, ps2, gs2, ty_unify(tb, fb, p, g, u))
    case Nil{} Nil{}:
      Some{u}
    case ps gs:
      None{}

def qts_unify?(+ps: List<&2, QT>, +gs: List<&2, QT>, +r: Maybe<&2, Un>) -> Maybe<&2, Un>:
  match r:
    case None{}:
      None{}
    case Some{u}:
      qts_unify.go(ps, gs, u)

def qts_unify.go?(+ps: List<&2, QT>, +gs: List<&2, QT>, +u: Un) -> Maybe<&2, Un>:
  match ps gs:
    case Con{p, ps2} Con{g, gs2}:
      qts_unify(ps2, gs2, qt_unify(p, g, u))
    case Nil{} Nil{}:
      Some{u}
    case ps gs:
      None{}

def qt_unify?(+p: QT, +g: QT, +u: Un) -> Maybe<&2, Un>:
  match p:
    case QV{n}:
      qt_unify.var(n, g, u, S.has.m(QT, Un.qm(u), n))
    case p:
      Bool.pick(Maybe<&2, Un>, qt_eq(qt_sub(p, Un.qm(u)), g), Some{u}, None{})

def qt_unify.var?(+n: String, +g: QT, +u: Un, +bound: Bool) -> Maybe<&2, Un>:
  match bound:
    case True{}:
      Bool.pick(Maybe<&2, Un>, qt_eq(M.get(QT, g, Un.qm(u), n), g), Some{u}, None{})
    case False{}:
      Some{Un{Un.m(u), M.set(QT, Un.qm(u), n, g)}}

# ty_wf : every type argument fits its parameter's declared kind (a tuple
# at &2 of Data parts, a + arrow of a Data domain)
def ty_wf?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T) -> Bool:
  match t:
    case TAdt{a, qs, args, iargs, spell}:
      tys_wf.adt(tb, fb, args, Adt.tps(adt_of(tb, a)), zip_q(Adt.qps(adt_of(tb, a)), qs, M.new(QT)))
    case TSig{x, a, b, q, spell}:
      ((U32.is_eq(q, 1) || (ty_data(tb, fb, a) && ty_data(tb, fb, b))) && ty_wf(tb, fb, a) && ty_wf(tb, fb, b))
    case TFun{q, dom, cod, ne}:
      ((Bool.not(U32.is_eq(q, 2)) || ty_data(tb, fb, dom)) && ty_wf(tb, fb, dom) && ty_wf(tb, fb, cod))
    case t:
      True{}

def tys_wf.adt?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +args: List<&2, T>, +tps: List<&2, TVI>, +qm: Map<&2, QT>) -> Bool:
  match args tps:
    case Con{x, xs} Con{TVI{n, q}, ts}:
      (qt_fits(ty_quant(tb, fb, x), qt_sub(q, qm)) && ty_wf(tb, fb, x) && tys_wf.adt(tb, fb, xs, ts, qm))
    case args tps:
      True{}

# ty_refutable : an equality of two different literals of an index type
# (for Nat, one side 0n), refuted through a discriminating family
def ty_refutable?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T) -> Bool:
  match t:
    case TEql{it, l, r}:
      (Bool.not(String.eq(l, r)) && idx_type(tb, fb, it) && (Bool.not(is_t(tb, it, "Nat")) || String.eq(l, "0n") || String.eq(r, "0n")))
    case t:
      False{}

# ty_showable : may a pure main of this type print as its literal? The
# runtimes print through a descriptor of main's type and refuse a
# function, an opaque handle, IO's own operations, an erased or a
# dependent field
def ty_showable?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T, +seen: Map<&2, Unit>) -> Bool:
  match t:
    case TEql{it, l, r}:
      True{}
    case TSig{x, a, b, q, spell}:
      (Bool.not(Maybe.is_some(&2, String, x)) && ty_showable(tb, fb, a, seen) && ty_showable(tb, fb, b, seen))
    case TApp{f, arg}:
      ty_showable.arm(tb, fb, fam_unfold(tb, fam_of(fb, f), arg), seen)
    case TAdt{a, qs, args, iargs, spell}:
      ty_showable.adt(tb, fb, adt_of(tb, a), t, args, seen)
    case t:
      False{}

def ty_showable.arm?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +m: Maybe<&2, T>, +seen: Map<&2, Unit>) -> Bool:
  match m:
    case None{}:
      False{}
    case Some{t}:
      ty_showable(tb, fb, t, seen)

def ty_showable.adt?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +a: Adt, +t: T, +args: List<&2, T>, +seen: Map<&2, Unit>) -> Bool:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = a
  ty_showable.cs(tb, fb, ctors, (String.eq(name, "U32") || String.eq(name, "F32") || (String.eq(name, "Array") && ty_showable(tb, fb, L.nth(T, TVar{"?", QL{1}}, args, 0), seen))),
    (Bool.not(List.is_empty(&2, IVar, ips)) || (base && String.eq(name, "IO.OP"))), S.has(seen, U32.show(id)), t, Set.add(seen, U32.show(id)))

def ty_showable.cs?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +ctors: Maybe<&2, List<&2, Ctor>>, +word: Bool, +no: Bool, +met: Bool, +t: T, +seen: Map<&2, Unit>) -> Bool:
  match ctors:
    case None{}:
      word
    case Some{cs}:
      (Bool.not(no) && If(Bool, met, u => True{}, u => ctors_showable(tb, fb, t, cs, seen)))

def ctors_showable?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +t: T, +cs: List<&2, Ctor>, +seen: Map<&2, Unit>) -> Bool:
  match cs:
    case []:
      True{}
    case c <> rest:
      (fields_showable(tb, fb, ctor_fields(tb, t, c), seen) && ctors_showable(tb, fb, t, rest, seen))

def fields_showable?(+tb: Map<&2, Adt>, +fb: Map<&2, Fam>, +fs: List<&2, Field>, +seen: Map<&2, Unit>) -> Bool:
  match fs:
    case []:
      True{}
    case Fd{q, ft} <> rest:
      (Bool.not(U32.is_eq(q, 0)) && ty_showable(tb, fb, ft, seen) && fields_showable(tb, fb, rest, seen))

# Reading the Base table
# ======================
# tokens : a line's tokens: names (letters, digits, _ and .), &0..&2, ->,
# =>, and every other character on its own

def tokens?(+s: String) -> List<&2, String>:
  tok(s, "", [])

def tok?(+s: String, +cur: String, +acc: List<&2, String>) -> List<&2, String>:
  match s:
    case SNil{}:
      L.rev(String, tok.flush(cur, acc), [])
    case SCon{c, t}:
      tok.c((Char.is_alpha(c) || Char.is_digit(c) || Char.is_eq(c, '_') || Char.is_eq(c, '.')), c, t, cur, acc)

def tok.flush?(+cur: String, +acc: List<&2, String>) -> List<&2, String>:
  Bool.pick(List<&2, String>, String.is_empty(cur), acc, String.reverse(cur) <> acc)

def tok.c?(+word: Bool, +c: Char, +t: String, +cur: String, +acc: List<&2, String>) -> List<&2, String>:
  match word:
    case True{}:
      tok(t, SCon{c, cur}, acc)
    case False{}:
      tok.sym(c, t, tok.flush(cur, acc), next_char(t))

def next_char?(+s: String) -> Char:
  match s:
    case SNil{}:
      ' '
    case SCon{c, t}:
      c

def tok.sym?(+c: Char, +t: String, +acc: List<&2, String>, +n: Char) -> List<&2, String>:
  tok.sym.go(Char.is_space(c), (Char.is_eq(c, '&') && Char.is_digit(n)) || (Char.is_eq(c, '-') && Char.is_eq(n, '>')) || (Char.is_eq(c, '=') && Char.is_eq(n, '>')), c, t, acc, n)

def tok.sym.go?(+space: Bool, +two: Bool, +c: Char, +t: String, +acc: List<&2, String>, +n: Char) -> List<&2, String>:
  match space:
    case True{}:
      tok(t, "", acc)
    case False{}:
      If(List<&2, String>, two, u => tok(String.drop(t, 1n), "", SCon{c, SCon{n, SNil{}}} <> acc), u => tok(t, "", SCon{c, SNil{}} <> acc))

# P(A) : a parser over tokens; None is a parse failure (the table is the
# fuzzer's own, so a failure is a bug in it)

def P(-A: Type) -> Type:
  List<&2, String> -> List<&2, String> & Maybe<&1, A>

def P.pure?(-A: Type, +x: A) -> P(A):
  s => (s, Some{x})

def P.fail?(-A: Type) -> P(A):
  s => (s, None{})

def P.bind.on?(-A: Type, -B: Type, +m: Maybe<&1, A>, f: A -> P(B), +s: List<&2, String>) -> List<&2, String> & Maybe<&1, B>:
  match m:
    case None{}:
      (s, None{})
    case Some{x}:
      f(x, s)

def P.bind.go?(-A: Type, -B: Type, f: A -> P(B), +r: List<&2, String> & Maybe<&1, A>) -> List<&2, String> & Maybe<&1, B>:
  (s, m) = r
  P.bind.on(A, B, m, f, s)

def P.bind?(-A: Type, -B: Type, +m: P(A), f: A -> P(B)) -> P(B):
  s => P.bind.go(A, B, f, m(s))

# peek : the next token ("" at the end); next : it, taken
def peek?(s: List<&2, String>) -> List<&2, String> & Maybe<&1, String>:
  match s:
    case []:
      ([], Some{""})
    case +h <> t:
      (h <> t, Some{h})

def next?(s: List<&2, String>) -> List<&2, String> & Maybe<&1, String>:
  match s:
    case []:
      ([], Some{""})
    case h <> t:
      (t, Some{h})

def eat?(+t: String) -> P(Unit):
  do P<Unit>:
    +x : String <-next
    eat.go(String.eq(x, t))

def eat.go?(+ok: Bool) -> P(Unit):
  match ok:
    case True{}:
      P.pure(Unit, Unit{})
    case False{}:
      P.fail(Unit)

# P.if : one of two parsers
def P.if?(-A: Type, +b: Bool, +t: P(A), +e: P(A)) -> P(A):
  match b:
    case True{}:
      t
    case False{}:
      e

# Sc : the names a type in the table may mention: quantity and type
# parameters
type Sc is Data:
  Sc{qs: Map<&2, Unit>, ts: Map<&2, QT>}

type QsTs is Data:
  QsTs{qs: List<&2, QT>, ts: List<&2, T>}

def Sc.qs?(+s: Sc) -> Map<&2, Unit>:
  Sc{qs, ts} = s
  qs

def Sc.ts?(+s: Sc) -> Map<&2, QT>:
  Sc{qs, ts} = s
  ts

def P.run?(-A: Type, +p: P(A), +toks: List<&2, String>) -> Maybe<&1, A>:
  Pair.snd(List<&2, String>, Maybe<&1, A>, p(toks))

# pquant : &0..&2, or a quantity variable in scope
def pquant?(+sc: Sc) -> P(QT):
  do P<QT>:
    +t : String <-next
    return pquant.of(t)

def pquant.of?(+t: String) -> QT:
  Bool.pick(QT, String.eq(t, "&0"), QL{0}, Bool.pick(QT, String.eq(t, "&1"), QL{1}, Bool.pick(QT, String.eq(t, "&2"), QL{2}, QV{t})))

# pkind : Data, Type or Kind(q) / Kind(a <&> b)
def pkind?(+sc: Sc) -> P(QT):
  do P<QT>:
    +t : String <-next
    pkind.go(String.eq(t, "Kind"), Bool.pick(QT, String.eq(t, "Data"), QL{2}, QL{1}), sc)

def pkind.go?(+kind: Bool, +lit: QT, +sc: Sc) -> P(QT):
  match kind:
    case False{}:
      P.pure(QT, lit)
    case True{}:
      do P<QT>:
        +u : Unit <-eat("(")
        +a : QT <- pquant(sc)
        +t : String <-peek
        +m : QT <-pkind.meet(String.eq(t, "<"), a, sc)
        +v : Unit <-eat(")")
        return m

def pkind.meet?(+meet: Bool, +a: QT, +sc: Sc) -> P(QT):
  match meet:
    case False{}:
      P.pure(QT, a)
    case True{}:
      do P<QT>:
        +u : Unit <-eat("<")
        +v : Unit <-eat("&")
        +w : Unit <-eat(">")
        +b : QT <-pquant(sc)
        return QM{a, b}

# ptype : A -> B, A & B, @-x: A -> B, (A), a type variable in scope, or a
# datatype of the table applied (Name<..> or Name(..); a missing quantity
# block is the Fill sugar: every quantity &1)
def ptype?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc) -> P(T):
  do P<T>:
    +d : T <- pamp(ids, tb, sc)
    +t : String <-peek
    ptype.arrow(String.eq(t, "->"), d, ids, tb, sc)

def ptype.arrow?(+yes: Bool, +d: T, +ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc) -> P(T):
  match yes:
    case False{}:
      P.pure(T, d)
    case True{}:
      do P<T>:
        +u : Unit <-eat("->")
        +c : T <-ptype(ids, tb, sc)
        return TFun{1, d, c, False{}}

def pamp?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc) -> P(T):
  do P<T>:
    +a : T <- patom(ids, tb, sc)
    +t : String <-peek
    pamp.go(String.eq(t, "&"), a, ids, tb, sc)

def pamp.go?(+yes: Bool, +a: T, +ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc) -> P(T):
  match yes:
    case False{}:
      P.pure(T, a)
    case True{}:
      do P<T>:
        +u : Unit <-eat("&")
        +b : T <-pamp(ids, tb, sc)
        return TSig{None{}, a, b, 1, 0}

def patom?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc) -> P(T):
  do P<T>:
    +t : String <- next
    P.if(T, String.eq(t, "("), patom.paren(ids, tb, sc), P.if(T, String.eq(t, "@"), patom.erased(ids, tb, sc), patom.name(t, ids, tb, sc)))

def patom.paren?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc) -> P(T):
  do P<T>:
    +x : T <-ptype(ids, tb, sc)
    +u : Unit <-eat(")")
    return x

# @-zq: A -> B (an erased arrow), @+zq: A -> B
def patom.erased?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc) -> P(T):
  do P<T>:
    +s : String <- next
    +n : String <-patom.skip(Bool.not((String.eq(s, "-") || String.eq(s, "+"))), s)
    +u : Unit <-eat(":")
    +d : T <-pamp(ids, tb, sc)
    +v : Unit <-eat("->")
    +c : T <-ptype(ids, tb, sc)
    return TFun{Bool.pick(U32, String.eq(s, "-"), 0, Bool.pick(U32, String.eq(s, "+"), 2, 1)), d, c, False{}}

# patom.skip : the binder's name, when a sigil came first
def patom.skip?(+named: Bool, +s: String) -> P(String):
  match named:
    case True{}:
      P.pure(String, s)
    case False{}:
      next

def patom.name?(+t: String, +ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc) -> P(T):
  P.if(T, S.has.m(QT, Sc.ts(sc), t), P.pure(T, TVar{t, M.get(QT, QL{1}, Sc.ts(sc), t)}),
    patom.adt(adt_of(tb, M.get(U32, 0, ids, t)), M.get(U32, 0, ids, t), ids, tb, sc))

def patom.adt?(+a: Adt, +id: U32, +ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc) -> P(T):
  do P<T>:
    +t : String <- peek
    +close : String = Bool.pick(String, String.eq(t, "<"), ">", Bool.pick(String, (String.eq(t, "(") && Adt.paren(a)), ")", ""))
    patom.args(String.is_empty(close), close, a, id, ids, tb, sc)

def patom.args?(+bare: Bool, +close: String, +a: Adt, +id: U32, +ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc) -> P(T):
  match bare:
    case True{}:
      P.pure(T, TAdt{id, [], [], [], 0})
    case False{}:
      do P<T>:
        +o : String <-next
        +f : String <- peek
        +explicit : Bool = (Bool.not(List.is_empty(&2, String, Adt.qps(a))) && (String.starts_with(f, "&") || S.has(Sc.qs(sc), f)))
        +r : QsTs <-pitems(ids, tb, sc, close, explicit, L.len(String, Adt.qps(a)), [], [], True{})
        return patom.inst(id, a, explicit, r)

def patom.inst?(+id: U32, +a: Adt, +explicit: Bool, +r: QsTs) -> T:
  QsTs{qs, ts} = r
  TAdt{id, Bool.pick(List<&2, QT>, explicit, qs, all_one(Adt.qps(a))), ts, [], 0}

def all_one?(+xs: List<&2, String>) -> List<&2, QT>:
  match xs:
    case []:
      []
    case h <> t:
      QL{1} <> all_one(t)

def pitems?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc, +close: String, +explicit: Bool, +nq: U32, +qs: List<&2, QT>, +ts: List<&2, T>, +first: Bool) -> P(QsTs):
  do P<QsTs>:
    +t : String <-peek
    pitems.go(String.eq(t, close), ids, tb, sc, close, explicit, nq, qs, ts, first)

def pitems.go?(+done: Bool, +ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc, +close: String, +explicit: Bool, +nq: U32, +qs: List<&2, QT>, +ts: List<&2, T>, +first: Bool) -> P(QsTs):
  match done:
    case True{}:
      do P<QsTs>:
        +u : Unit <-eat(close)
        return QsTs{L.rev(QT, qs, []), L.rev(T, ts, [])}
    case False{}:
      do P<QsTs>:
        +u : Unit <-P.if(Unit, first, P.pure(Unit, Unit{}), eat(","))
        P.if(QsTs, (explicit && (L.len(QT, qs) < nq : U32)), pitems.q(ids, tb, sc, close, explicit, nq, qs, ts), pitems.t(ids, tb, sc, close, explicit, nq, qs, ts))

def pitems.q?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc, +close: String, +explicit: Bool, +nq: U32, +qs: List<&2, QT>, +ts: List<&2, T>) -> P(QsTs):
  do P<QsTs>:
    +q : QT <-pquant(sc)
    pitems(ids, tb, sc, close, explicit, nq, q <> qs, ts, False{})

def pitems.t?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc, +close: String, +explicit: Bool, +nq: U32, +qs: List<&2, QT>, +ts: List<&2, T>) -> P(QsTs):
  do P<QsTs>:
    +t : T <-ptype(ids, tb, sc)
    pitems(ids, tb, sc, close, explicit, nq, qs, t <> ts, False{})

# Hd : a header being read: its scope, its quantity and type parameters,
# the telescope's order of them, its value parameters and template count
type Hd is Data:
  Hd{sc: Sc, qps: List<&2, String>, tps: List<&2, TVI>, hdr: List<&2, String>, ps: List<&2, Param>, tm: U32}

def Hd0?() -> Hd:
  Hd{Sc{Set.new(), M.new(QT)}, [], [], [], [], 0}

def Hd.sc?(+h: Hd) -> Sc:
  Hd{sc, qps, tps, hdr, ps, tm} = h
  sc

# Hd.q / Hd.t / Hd.v : a quantity, type or value parameter added
def Hd.q?(+h: Hd, +n: String, +tmpl: Bool) -> Hd:
  Hd{sc, qps, tps, hdr, ps, tm} = h
  Hd{Sc{Set.add(Sc.qs(sc), n), Sc.ts(sc)}, n <> qps, tps, n <> hdr, ps, Bool.pick(U32, tmpl, (tm + 1 : U32), tm)}

def Hd.t?(+h: Hd, +n: String, +q: QT, +tmpl: Bool) -> Hd:
  Hd{sc, qps, tps, hdr, ps, tm} = h
  Hd{Sc{Sc.qs(sc), M.set(QT, Sc.ts(sc), n, q)}, qps, TVI{n, q} <> tps, n <> hdr, ps, Bool.pick(U32, tmpl, (tm + 1 : U32), tm)}

def Hd.v?(+h: Hd, +p: Param, +tmpl: Bool) -> Hd:
  Hd{sc, qps, tps, hdr, ps, tm} = h
  Hd{sc, qps, tps, hdr, p <> ps, Bool.pick(U32, tmpl, (tm + 1 : U32), tm)}

# pparams : a parameter list up to its closer: a bare name (or ~a: Quant)
# is a quantity parameter, -A: Kind(..) / Type / Data a type parameter,
# the rest value parameters with their sigils (~ a template)
def pparams?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +close: String, +h: Hd, +first: Bool) -> P(Hd):
  do P<Hd>:
    +t : String <-peek
    pparams.go(String.eq(t, close), ids, tb, close, h, first)

def pparams.go?(+done: Bool, +ids: Map<&2, U32>, +tb: Map<&2, Adt>, +close: String, +h: Hd, +first: Bool) -> P(Hd):
  match done:
    case True{}:
      do P<Hd>:
        +u : Unit <-eat(close)
        return h
    case False{}:
      do P<Hd>:
        +u : Unit <-P.if(Unit, first, P.pure(Unit, Unit{}), eat(","))
        +s : String <- peek
        +sig : Bool = (String.eq(s, "~") || String.eq(s, "+") || String.eq(s, "-"))
        +v : String <-P.if(String, sig, next, P.pure(String, ""))
        +n : String <- next
        +c : String <- peek
        +h2 : Hd <-pparam(String.eq(c, ":"), ids, tb, h, s, sig, n)
        pparams(ids, tb, close, h2, False{})

def pparam?(+typed: Bool, +ids: Map<&2, U32>, +tb: Map<&2, Adt>, +h: Hd, +s: String, +sig: Bool, +n: String) -> P(Hd):
  match typed:
    case False{}:
      P.pure(Hd, Hd.q(h, n, False{}))
    case True{}:
      do P<Hd>:
        +u : Unit <-eat(":")
        +k : String <- peek
        P.if(Hd, String.eq(k, "Quant"), pparam.quant(h, n),
          P.if(Hd, (String.eq(k, "Kind") || String.eq(k, "Type") || String.eq(k, "Data")), pparam.kind(h, n, String.eq(s, "~")),
            pparam.value(ids, tb, h, s, sig, n)))

def pparam.quant?(+h: Hd, +n: String) -> P(Hd):
  do P<Hd>:
    +u : String <-next
    return Hd.q(h, n, True{})

def pparam.kind?(+h: Hd, +n: String, +tmpl: Bool) -> P(Hd):
  do P<Hd>:
    +q : QT <-pkind(Hd.sc(h))
    return Hd.t(h, n, q, tmpl)

def pparam.value?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +h: Hd, +s: String, +sig: Bool, +n: String) -> P(Hd):
  do P<Hd>:
    +t : T <-ptype(ids, tb, Hd.sc(h))
    return Hd.v(h, Pm{Bool.pick(U32, String.eq(s, "-"), 0, Bool.pick(U32, String.eq(s, "+"), 2, 1)), t, n, False{}, 0}, String.eq(s, "~"))

# pdef : def NAME(params) -> TYPE [# stuck]
def pdef?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>) -> P(Def):
  do P<Def>:
    +u : Unit <-eat("def")
    +name : String <- next
    +v : Unit <-eat("(")
    +h : Hd <- pparams(ids, tb, ")", Hd0(), True{})
    +w : Unit <-eat("->")
    +ret : T <- ptype(ids, tb, Hd.sc(h))
    +t : String <- peek
    return pdef.mk(name, h, ret, String.eq(t, "#"))

def pdef.mk?(+name: String, +h: Hd, +ret: T, +stuck: Bool) -> Def:
  Hd{sc, qps, tps, hdr, ps, tm} = h
  Def{name, L.rev(String, qps, []), L.rev(TVI, tps, []), L.rev(String, hdr, []), L.rev(Param, ps, []), ret, tm, stuck, True{}}

# phead : type NAME<params> is KIND / opaque NAME(params) is KIND, answering
# the datatype (its constructors come later) and its scope
type AdtSc is Data:
  AdtSc{a: Adt, sc: Sc}

def phead?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +id: U32) -> P(AdtSc):
  do P<AdtSc>:
    +kw : String <- next
    +name : String <- next
    +o : String <- peek
    +open : Bool = (String.eq(o, "<") || String.eq(o, "("))
    +u : String <-P.if(String, open, next, P.pure(String, ""))
    +h : Hd <- P.if(Hd, open, pparams(ids, tb, Bool.pick(String, String.eq(o, "<"), ">", ")"), Hd0(), True{}), P.pure(Hd, Hd0()))
    +v : Unit <-eat("is")
    +k : QT <- pkind(Hd.sc(h))
    return phead.mk(id, name, String.eq(kw, "type"), String.eq(o, "("), h, k)

def phead.mk?(+id: U32, +name: String, +transparent: Bool, +paren: Bool, +h: Hd, +k: QT) -> AdtSc:
  Hd{sc, qps, tps, hdr, ps, tm} = h
  AdtSc{Adt{id, name, L.rev(String, qps, []), L.rev(TVI, tps, []), [], k, Bool.pick(Maybe<&2, List<&2, Ctor>>, transparent, Some{[]}, None{}), paren, True{}, False{}}, sc}

# prow : K{T, +T, -T}: a constructor row
def prow?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc) -> P(Ctor):
  do P<Ctor>:
    +name : String <- next
    +u : Unit <-eat("{")
    +fs : List<&2, Field> <-prow.fields(ids, tb, sc, [], True{})
    return Ct{name, fs}

def prow.fields?(+ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc, +acc: List<&2, Field>, +first: Bool) -> P(List<&2, Field>):
  do P<List<&2, Field>>:
    +t : String <-peek
    prow.fields.go(String.eq(t, "}"), ids, tb, sc, acc, first)

def prow.fields.go?(+done: Bool, +ids: Map<&2, U32>, +tb: Map<&2, Adt>, +sc: Sc, +acc: List<&2, Field>, +first: Bool) -> P(List<&2, Field>):
  match done:
    case True{}:
      do P<List<&2, Field>>:
        +u : Unit <-eat("}")
        return L.rev(Field, acc, [])
    case False{}:
      do P<List<&2, Field>>:
        +u : Unit <-P.if(Unit, first, P.pure(Unit, Unit{}), eat(","))
        +s : String <- peek
        +sig : Bool = (String.eq(s, "+") || String.eq(s, "-"))
        +v : String <-P.if(String, sig, next, P.pure(String, ""))
        +t : T <-ptype(ids, tb, sc)
        prow.fields(ids, tb, sc, Fd{Bool.pick(U32, String.eq(s, "-"), 0, Bool.pick(U32, String.eq(s, "+"), 2, 1)), t} <> acc, False{})

# The Base table
# ==============
# The fuzzer's own redefinition of Base: its datatypes and an explicitly
# picked set of its defs, in Base's declaration syntax (the TS fuzzer's
# table, the same text). A datatype with constructors is transparent; an
# `opaque` one is built and read through literals and calls only. A def
# marked `# stuck` reaches a native claim (F32's ops): off the pure side.
# The effects are not in it: only the IO tail performs them.

# BEGIN BASE_TABLE (generated by tools/table.py)
def BASE_TABLE?() -> List<&2, String>:
  [
