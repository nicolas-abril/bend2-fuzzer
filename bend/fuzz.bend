# Arm : a family's arm; sub: the sub-index a successor arm binds, src the name it binds under first
type Arm is Data:
  Arm{pat: String, sub: Maybe<&2, String>, lit: Maybe<&2, String>, ty: T, src: String}

def Arm.pat?(+r: Arm) -> String:
  Arm{pat, sub, lit, ty, src} = r
  pat

def Arm.sub?(+r: Arm) -> Maybe<&2, String>:
  Arm{pat, sub, lit, ty, src} = r
  sub

def Arm.lit?(+r: Arm) -> Maybe<&2, String>:
  Arm{pat, sub, lit, ty, src} = r
  lit

def Arm.ty?(+r: Arm) -> T:
  Arm{pat, sub, lit, ty, src} = r
  ty

def Arm.src?(+r: Arm) -> String:
  Arm{pat, sub, lit, ty, src} = r
  src

# Fam : a type-level def by match on one index
type Fam is Data:
  Fam{id: U32, name: String, idx: T, kind: QT, arms: List<&2, Arm>, done: Bool}

def Fam.id?(+r: Fam) -> U32:
  Fam{id, name, idx, kind, arms, done} = r
  id

def Fam.set_id?(+v: U32, +r: Fam) -> Fam:
  Fam{id, name, idx, kind, arms, done} = r
  Fam{v, name, idx, kind, arms, done}

def Fam.name?(+r: Fam) -> String:
  Fam{id, name, idx, kind, arms, done} = r
  name

def Fam.set_name?(+v: String, +r: Fam) -> Fam:
  Fam{id, name, idx, kind, arms, done} = r
  Fam{id, v, idx, kind, arms, done}

def Fam.idx?(+r: Fam) -> T:
  Fam{id, name, idx, kind, arms, done} = r
  idx

def Fam.set_idx?(+v: T, +r: Fam) -> Fam:
  Fam{id, name, idx, kind, arms, done} = r
  Fam{id, name, v, kind, arms, done}

def Fam.kind?(+r: Fam) -> QT:
  Fam{id, name, idx, kind, arms, done} = r
  kind

def Fam.set_kind?(+v: QT, +r: Fam) -> Fam:
  Fam{id, name, idx, kind, arms, done} = r
  Fam{id, name, idx, v, arms, done}

def Fam.arms?(+r: Fam) -> List<&2, Arm>:
  Fam{id, name, idx, kind, arms, done} = r
  arms

def Fam.set_arms?(+v: List<&2, Arm>, +r: Fam) -> Fam:
  Fam{id, name, idx, kind, arms, done} = r
  Fam{id, name, idx, kind, v, done}

def Fam.done?(+r: Fam) -> Bool:
  Fam{id, name, idx, kind, arms, done} = r
  done

def Fam.set_done?(+v: Bool, +r: Fam) -> Fam:
  Fam{id, name, idx, kind, arms, done} = r
  Fam{id, name, idx, kind, arms, v}

# Param : a value parameter of the registry; its type may name an earlier parameter n of an index type (dep: later types depend on it); mask caps an argument (0: none)
type Param is Data:
  Pm{q: U32, t: T, n: String, dep: Bool, mask: U32}

def Param.q?(+r: Param) -> U32:
  Pm{q, t, n, dep, mask} = r
  q

def Param.set_q?(+v: U32, +r: Param) -> Param:
  Pm{q, t, n, dep, mask} = r
  Pm{v, t, n, dep, mask}

def Param.t?(+r: Param) -> T:
  Pm{q, t, n, dep, mask} = r
  t

def Param.set_t?(+v: T, +r: Param) -> Param:
  Pm{q, t, n, dep, mask} = r
  Pm{q, v, n, dep, mask}

def Param.n?(+r: Param) -> String:
  Pm{q, t, n, dep, mask} = r
  n

def Param.set_n?(+v: String, +r: Param) -> Param:
  Pm{q, t, n, dep, mask} = r
  Pm{q, t, v, dep, mask}

def Param.dep?(+r: Param) -> Bool:
  Pm{q, t, n, dep, mask} = r
  dep

def Param.set_dep?(+v: Bool, +r: Param) -> Param:
  Pm{q, t, n, dep, mask} = r
  Pm{q, t, n, v, mask}

def Param.mask?(+r: Param) -> U32:
  Pm{q, t, n, dep, mask} = r
  mask

def Param.set_mask?(+v: U32, +r: Param) -> Param:
  Pm{q, t, n, dep, mask} = r
  Pm{q, t, n, dep, v}

# Def : a callable def: hdr lists the quantity and type parameters in the telescope's order; tm counts the leading template parameters; stuck: reaches a native claim (off the pure side)
type Def is Data:
  Def{name: String, qps: List<&2, String>, tps: List<&2, TVI>, hdr: List<&2, String>, ps: List<&2, Param>, ret: T, tm: U32, stuck: Bool, base: Bool}

def Def.name?(+r: Def) -> String:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  name

def Def.set_name?(+v: String, +r: Def) -> Def:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  Def{v, qps, tps, hdr, ps, ret, tm, stuck, base}

def Def.qps?(+r: Def) -> List<&2, String>:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  qps

def Def.set_qps?(+v: List<&2, String>, +r: Def) -> Def:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  Def{name, v, tps, hdr, ps, ret, tm, stuck, base}

def Def.tps?(+r: Def) -> List<&2, TVI>:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  tps

def Def.set_tps?(+v: List<&2, TVI>, +r: Def) -> Def:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  Def{name, qps, v, hdr, ps, ret, tm, stuck, base}

def Def.hdr?(+r: Def) -> List<&2, String>:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  hdr

def Def.set_hdr?(+v: List<&2, String>, +r: Def) -> Def:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  Def{name, qps, tps, v, ps, ret, tm, stuck, base}

def Def.ps?(+r: Def) -> List<&2, Param>:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  ps

def Def.set_ps?(+v: List<&2, Param>, +r: Def) -> Def:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  Def{name, qps, tps, hdr, v, ret, tm, stuck, base}

def Def.ret?(+r: Def) -> T:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  ret

def Def.set_ret?(+v: T, +r: Def) -> Def:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  Def{name, qps, tps, hdr, ps, v, tm, stuck, base}

def Def.tm?(+r: Def) -> U32:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  tm

def Def.set_tm?(+v: U32, +r: Def) -> Def:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
  Def{name, qps, tps, hdr, ps, ret, v, stuck, base}

def Def.stuck?(+r: Def) -> Bool:
  Def{name, qps, tps, hdr, ps, ret, tm, stuck, base} = r
