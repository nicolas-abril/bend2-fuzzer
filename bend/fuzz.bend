  St{rng: U32, uid: U32, vid: U32, steps: U32, base: Bool, free: Bool, pure: Bool, trans: Bool, tmpl: Bool, surface: U32, names: Map<&2, Unit>, decls: List<&2, String>, entries: List<&2, String>, adts: Map<&2, Adt>, own: List<&2, U32>, fams: Map<&2, Fam>, famids: List<&2, U32>, defs: List<&2, Def>, memo: Map<&2, String>, wip: Map<&2, Unit>, wips: List<&2, Wip>, mints: U32, maxmints: U32, feats: Map<&2, U32>, framed: Map<&2, String>, dead: Map<&2, Unit>, cost: Map<&2, U32>, reg: Reg, idn: U32, leaves: U32}

