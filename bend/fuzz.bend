# Differential fuzzer for the bend2-core toolchain, in Bend.
#
# The port of fuzz.ts (tag bend2-ts): each seed deterministically generates a
# well-typed, terminating Bend program in two algebraically-equal spellings
# (raw and identity-sealed), and the fuzzer cross-checks the toolchain's legs
# through its command line: the interpreter (a pure main normalized by
# `bend`), and the C and JS emissions (`bend -o x.c -o x.js`), built with
# clang and run sequentially, in parallel and under bun.
#
# The model is the TS fuzzer's: types are read from the fuzzer's own
# redefinition of Base (BASE_TABLE, Base's declaration syntax), every def
# of it is a call at any goal of its return type, operators follow the
# parser's table, defs are one production, sizes draw from one power-law
# distribution, and ty_cost completes every term. See README and NOTES.
#
# Bend shapes the code: there is no mutation, so the generator is a state
# monad (G: St -> St & Maybe<A>, a None the failure every production may
# answer, whose bind short-circuits like the TS exceptions); a match heads
# a def body and takes a parameter or a field, so a branch is a def of its
# own; a closure is affine, so a list is walked by a recursive def rather
# than mapped with a closure. Every def is `?` (it may recurse and call a
# def written below it).

import Base

# Types
# =====
# The generator's mirror of the object language. QT is a quantity term: a
# literal (&0/&1/&2), a variable, or a meet. A nominal type is an adt
# instance, its datatype named by id in the world's table (W); sig is Base's
# Sigma (a tuple when x is None); eql is an equality of index literals.
# spell: an adt 0 plain, 1 Or(A, B), 2 A | B; a sig 0 A & B, 1 Pair(A, B),
# 2 Sigma<..>, 3 Exists(..); a fun's ne spells {l != r : T}.

type QT is Data:
  QL{q: U32}
  QV{n: String}
  QM{a: QT, b: QT}

type T is Data:
  TVar{n: String, q: QT}
  TAdt{a: U32, qs: List<&2, QT>, args: List<&2, T>, iargs: List<&2, String>, spell: U32}
  TApp{f: U32, arg: String}
  TSig{x: Maybe<&2, String>, a: T, b: T, q: U32, spell: U32}
  TFun{q: U32, dom: T, cod: T, ne: Bool}
  TEql{t: T, l: String, r: String}

type Field is Data:
  Fd{q: U32, t: T}

type Ctor is Data:
  Ct{name: String, fields: List<&2, Field>}

type TVI is Data:
  TVI{n: String, q: QT}

# IVar : a term in scope a type may mention (an index parameter, an arm's
# sub-index — sub: the one place an unfinished family may be applied)
type IVar is Data:
  IV{n: String, t: T, sub: Bool}

# If : a lazy conditional. Bool.pick, && and || are calls: they evaluate
# every argument, so a branch that recurses (or a guard a recursion leans
# on) goes behind If, whose branches are closures and only one runs
def If?(-A: Type, +c: Bool, t: Unit -> A, e: Unit -> A) -> A:
  match c:
    case True{}:
      t(Unit{})
    case False{}:
      e(Unit{})

# Lists and strings
# =================

def L.len?(-A: Data, +xs: List<&2, A>) -> U32:
  match xs:
    case []:
      0
    case h <> t:
      (1 + L.len(A, t) : U32)

def L.nth?(-A: Data, +d: A, +xs: List<&2, A>, +i: U32) -> A:
  match xs:
    case []:
      d
    case h <> t:
      L.nth.go(A, U32.is_zero(i), d, h, t, i)

def L.nth.go?(-A: Data, +z: Bool, +d: A, +h: A, +t: List<&2, A>, +i: U32) -> A:
  match z:
    case True{}:
      h
    case False{}:
      L.nth(A, d, t, (i - 1 : U32))

def L.rev?(-A: Data, +xs: List<&2, A>, +acc: List<&2, A>) -> List<&2, A>:
  match xs:
    case []:
      acc
    case h <> t:
      L.rev(A, t, h <> acc)

def L.cat?(-A: Data, +xs: List<&2, A>, +ys: List<&2, A>) -> List<&2, A>:
  L.rev(A, L.rev(A, xs, []), ys)

def L.drop_nth?(-A: Data, +xs: List<&2, A>, +i: U32) -> List<&2, A>:
  match xs:
    case []:
      []
    case h <> t:
      L.drop_nth.go(A, U32.is_zero(i), h, t, i)

def L.drop_nth.go?(-A: Data, +z: Bool, +h: A, +t: List<&2, A>, +i: U32) -> List<&2, A>:
  match z:
    case True{}:
      t
    case False{}:
      h <> L.drop_nth(A, t, (i - 1 : U32))

def S.has?(+s: Map<&2, Unit>, +k: String) -> Bool:
  Pair.snd(Map<&2, Unit>, Bool, Set.has(s, k))

def S.eq?(+a: String, +b: String) -> Bool:
  String.eq(a, b)

def S.in?(+k: String, +xs: List<&2, String>) -> Bool:
  match xs:
    case []:
      False{}
    case h <> t:
      (String.eq(h, k) || S.in(k, t))

def S.join?(+xs: List<&2, String>, +sep: String) -> String:
  String.join(xs, sep)

def S.is_empty?(+s: String) -> Bool:
  String.is_empty(s)

# BEGIN St (generated by tools/st.py)
# Adt : a datatype. ctors None: opaque (built and read only through literals and calls); paren: a type-level def, applied as Name(args); rec: a constructor holds the type at its own parameters
type Adt is Data:
  Adt{id: U32, name: String, qps: List<&2, String>, tps: List<&2, TVI>, ips: List<&2, IVar>, kind: QT, ctors: Maybe<&2, List<&2, Ctor>>, paren: Bool, base: Bool, rec: Bool}

def Adt.id?(+r: Adt) -> U32:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  id

def Adt.set_id?(+v: U32, +r: Adt) -> Adt:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  Adt{v, name, qps, tps, ips, kind, ctors, paren, base, rec}

def Adt.name?(+r: Adt) -> String:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  name

def Adt.set_name?(+v: String, +r: Adt) -> Adt:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  Adt{id, v, qps, tps, ips, kind, ctors, paren, base, rec}

def Adt.qps?(+r: Adt) -> List<&2, String>:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  qps

def Adt.set_qps?(+v: List<&2, String>, +r: Adt) -> Adt:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  Adt{id, name, v, tps, ips, kind, ctors, paren, base, rec}

def Adt.tps?(+r: Adt) -> List<&2, TVI>:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  tps

def Adt.set_tps?(+v: List<&2, TVI>, +r: Adt) -> Adt:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  Adt{id, name, qps, v, ips, kind, ctors, paren, base, rec}

def Adt.ips?(+r: Adt) -> List<&2, IVar>:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  ips

def Adt.set_ips?(+v: List<&2, IVar>, +r: Adt) -> Adt:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  Adt{id, name, qps, tps, v, kind, ctors, paren, base, rec}

def Adt.kind?(+r: Adt) -> QT:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  kind

def Adt.set_kind?(+v: QT, +r: Adt) -> Adt:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  Adt{id, name, qps, tps, ips, v, ctors, paren, base, rec}

def Adt.ctors?(+r: Adt) -> Maybe<&2, List<&2, Ctor>>:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  ctors

def Adt.set_ctors?(+v: Maybe<&2, List<&2, Ctor>>, +r: Adt) -> Adt:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  Adt{id, name, qps, tps, ips, kind, v, paren, base, rec}

def Adt.paren?(+r: Adt) -> Bool:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  paren

def Adt.set_paren?(+v: Bool, +r: Adt) -> Adt:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  Adt{id, name, qps, tps, ips, kind, ctors, v, base, rec}

def Adt.base?(+r: Adt) -> Bool:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  base

def Adt.set_base?(+v: Bool, +r: Adt) -> Adt:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
  Adt{id, name, qps, tps, ips, kind, ctors, paren, v, rec}

def Adt.rec?(+r: Adt) -> Bool:
  Adt{id, name, qps, tps, ips, kind, ctors, paren, base, rec} = r
